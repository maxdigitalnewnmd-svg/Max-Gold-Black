rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección Gestor: Precios en tiempo real y Bóveda de liquidez
    match /Gestor/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Colección Taller: Camionetas, costos, combustible y reparación
    match /Taller/{docId} {
      allow read: if true;
    }

    // Colección de jugadores y progreso económico
    match /jugadores/{playerId} {
      allow read, write: if true;
    }

    // Colección de Usuarios
    match /Usuarios/{docId} {
      allow read, write: if true;
    }

    // Cualquier otra ruta queda protegida
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
